{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Synapse Design Tokens",
  "version": "2.0.0",
  "typography": {
    "fontFamily": {
      "sans": ["Plus Jakarta Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
      "mono": ["JetBrains Mono", "monospace"]
    }
  },
  "palette": {
    "primary": {
      "50": "#eff6ff",
      "100": "#dbeafe",
      "200": "#bfdbfe",
      "300": "#93c5fd",
      "400": "#60a5fa",
      "500": "#3b82f6",
      "600": "#2563eb",
      "700": "#1d4ed8",
      "800": "#1e40af",
      "900": "#1e3a8a"
    },
    "accents": {
      "cyan": "#0ea5e9",
      "emerald": "#10b981",
      "amber": "#f59e0b",
      "rose": "#f43f5e",
      "purple": "#8b5cf6",
      "indigo": "#6366f1"
    }
  },
  "themes": {
    "light": {
      "name": "Polar Slate",
      "colors": {
        "bg": {
          "background": "#f8fafc",
          "surface": "#ffffff",
          "surfaceHover": "#f1f5f9",
          "surfaceElevated": "#ffffff"
        },
        "border": {
          "default": "#e2e8f0",
          "subtle": "rgba(0, 0, 0, 0.05)"
        },
        "text": {
          "primary": "#0f172a",
          "secondary": "#334155",
          "muted": "#64748b",
          "subtle": "#94a3b8"
        },
        "canvas": {
          "background": "#f8fafc",
          "roadDefault": "#000000",
          "roadActive": "#ea580c",
          "roadMonitored": "#0284c7",
          "roadSelected": "#0284c7",
          "node": "#000000",
          "nodeActive": "#0284c7"
        },
        "charts": {
          "tooltipBg": "#ffffff",
          "tooltipBorder": "#e2e8f0",
          "tooltipText": "#0f172a",
          "axisLine": "#e2e8f0",
          "axisLabel": "#64748b",
          "splitLine": "rgba(226, 232, 240, 0.8)",
          "yAxisLabel": "#94a3b8"
        }
      }
    },
    "dark": {
      "name": "Obsidian Slate",
      "colors": {
        "bg": {
          "background": "#0d1117",
          "surface": "#161b22",
          "surfaceHover": "#1f2633",
          "surfaceElevated": "#212936"
        },
        "border": {
          "default": "#252f3f",
          "subtle": "rgba(255, 255, 255, 0.06)"
        },
        "text": {
          "primary": "#f8fafc",
          "secondary": "#cbd5e1",
          "muted": "#94a3b8",
          "subtle": "#64748b"
        },
        "canvas": {
          "background": "#0b0f17",
          "roadDefault": "#384355",
          "roadActive": "#f59e0b",
          "roadMonitored": "#0ea5e9",
          "roadSelected": "#00f2fe",
          "node": "#64748b",
          "nodeActive": "#0ea5e9"
        },
        "charts": {
          "tooltipBg": "#161b22",
          "tooltipBorder": "#252f3f",
          "tooltipText": "#f1f5f9",
          "axisLine": "#252f3f",
          "axisLabel": "#94a3b8",
          "splitLine": "rgba(37, 47, 63, 0.5)",
          "yAxisLabel": "#64748b"
        }
      }
    }
  }
}
